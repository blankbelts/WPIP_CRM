# WPIP CRM - zmienne srodowiskowe (skopiuj do .env lub ustaw w panelu hostingu)
# Katalog na plik bazy SQLite. Na serwerze: trwaly wolumen/dysk (NIE katalog aplikacji).
DATA_DIR=/data
# Port HTTP (Railway ustawia sam; lokalnie domyslnie 3400)
PORT=3400
# Konto administratora - tworzone TYLKO przy pierwszym starcie na pustej bazie
CRM_LOGIN=admin
CRM_HASLO=zmien-to-na-silne-haslo
CRM_IMIE=Krystian
